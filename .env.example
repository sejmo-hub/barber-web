# PostgreSQL connection string used by Prisma (loaded via prisma.config.ts).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# The database must allow the btree_gist extension (needed by the init migration).
DATABASE_URL="postgresql://user:password@localhost:5432/barber?schema=public"

# Optional: only needed if your Postgres user cannot CREATE DATABASE for
# Prisma's shadow database during `prisma migrate dev` (common on managed
# Postgres like Neon/Supabase). Point it at a second empty database.
# SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/barber_shadow?schema=public"

# Resend – emailové notifikácie po rezervácii.
# Testovací režim (bez overenej domény): MAIL_FROM musí byť presne
# "onboarding@resend.dev" a e-maily chodia len na tvoj registračný e-mail.
RESEND_API_KEY=""
MAIL_FROM="onboarding@resend.dev"
BARBER_EMAIL=""

# Admin login (/admin/*). Heslo NIKDY neukladaj v plain texte – ulož bcrypt hash.
# Vygeneruj hash:  node -e "console.log(require('bcryptjs').hashSync('TVOJE_HESLO',10))"
# V .env escapuj $ v hashi ako \$ (Next.js .env expanduje premenné).
# SESSION_SECRET vygeneruj:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_USERNAME=""
ADMIN_PASSWORD_HASH=""
SESSION_SECRET=""
